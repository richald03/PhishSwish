    <!-- Privacy Policy -->
    <string name="title_privacy_policy">Privacy Policy</string>
    <string name="pp_section1_title">1. Introduction</string>
    <string name="pp_section1_body">PhishSwish respects your privacy and is committed to protecting your personal information while providing scam detection services.</string>
    <string name="pp_section2_title">2. Information We Collect</string>
    <string name="pp_section2_body">We may collect:\n- Account information (email, username)\n- User-submitted scam reports\n- Limited usage analytics to improve performance\nWe do not access personal messages without user permission.</string>
    <string name="pp_section3_title">3. How We Use Information</string>
    <string name="pp_section3_body">We use collected information to:\n- Authenticate user accounts\n- Improve scam detection accuracy\n- Enhance user experience and security</string>
    <string name="pp_section4_title">4. Data Security</string>
    <string name="pp_section4_body">We implement secure authentication and controlled cloud storage to protect user data from unauthorized access.</string>
    <string name="pp_section5_title">5. Data Sharing</string>
    <string name="pp_section5_body">We do not sell or trade user data. Information is only shared when legally required.</string>
    <string name="pp_section6_title">6. Your Rights</string>
    <string name="pp_section6_body">Users may update account information or request data deletion by contacting support.</string>
    <string name="pp_section7_title">7. Contact Us</string>
    <string name="pp_contact_email">aldrichpayawal3@gmail.com</string>

    <!-- FAQs -->
    <string name="title_faqs">FAQs</string>
    <string name="faq_header_common">COMMON QUESTIONS</string>
    <string name="faq1_q">How does PhishSwish work?</string>
    <string name="faq1_a">PhishSwish uses advanced machine learning models and pattern detection to analyze SMS content and links for potential security threats like phishing or spam.</string>
    <string name="faq2_q">Is my data private?</string>
    <string name="faq2_a">Yes. We only analyze messages you specifically choose to scan. Your personal information is encrypted and never shared with third parties.</string>
    <string name="faq3_q">What should I do if I receive a scam?</string>
    <string name="faq3_a">If PhishSwish detects a scam, do not click any links. Delete the message immediately and block the sender\'s number through your phone\'s SMS app.</string>
    <string name="faq4_q">Can PhishSwish read my messages?</string>
    <string name="faq4_a">PhishSwish only accesses your inbox when you open the \'Inbox Scan\' tool. Analysis is performed on-device to ensure your private conversations stay private.</string>
    <string name="faq_still_questions">Still have questions?</string>
    <string name="faq_support_help">Our support team is here to help you.</string>
    <string name="btn_contact_support">Contact Support</string>

