<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient">

    <!-- Ambient Glow (Scaled Down) -->
    <View
        android:id="@+id/vHalo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_halo_circle"
        android:alpha="0.4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"/>

    <!-- Decorative background dots around the image -->
    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/dot_active"
        android:backgroundTint="#93C5FD"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="@id/vHalo"
        app:layout_constraintStart_toStartOf="@id/vHalo"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"/>

    <View
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/dot_active"
        android:backgroundTint="#BFDBFE"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="@id/vHalo"
        app:layout_constraintEnd_toEndOf="@id/vHalo"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="30dp"/>

    <View
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:background="@drawable/dot_active"
        android:backgroundTint="#2F6FED"
        android:alpha="0.4"
        app:layout_constraintTop_toBottomOf="@id/vHalo"
        app:layout_constraintStart_toEndOf="@id/vHalo"
        android:layout_marginTop="-30dp"
        android:layout_marginStart="-20dp"/>

    <!-- High-Quality Phone Scanner Design (Scaled Down) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardIcon"
        android:layout_width="90dp"
        android:layout_height="155dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#1F2937"
        app:layout_constraintTop_toTopOf="@id/vHalo"
        app:layout_constraintBottom_toBottomOf="@id/vHalo"
        app:layout_constraintStart_toStartOf="@id/vHalo"
        app:layout_constraintEnd_toEndOf="@id/vHalo">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Dynamic Island / Notch -->
                <View
                    android:id="@+id/phoneNotch"
                    android:layout_width="28dp"
                    android:layout_height="10dp"
                    android:background="#1F2937"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Mock UI Content -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_dialog_email"
                    android:tint="@color/divider"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <!-- Scanning Animation Visual -->
                <View
                    android:id="@+id/vScanningLine"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#2F6FED"
                    android:alpha="0.8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.45"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_onboarding_gradient"
                    android:alpha="0.2"
                    app:layout_constraintTop_toTopOf="@id/vScanningLine"/>

                <!-- Home Bar -->
                <View
                    android:layout_width="20dp"
                    android:layout_height="3dp"
                    android:background="#E5E7EB"
                    android:layout_marginBottom="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>

    <!-- Professional Status Popups (Scaled and Positioned) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/chipSafe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="@id/cardIcon"
        app:layout_constraintStart_toEndOf="@id/cardIcon"
        android:layout_marginStart="16dp"
        android:layout_marginTop="5dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="✓ SAFE"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="@color/surface"
            android:background="#059669"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/chipSpam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="@id/cardIcon"
        app:layout_constraintTop_toTopOf="@id/cardIcon"
        app:layout_constraintEnd_toStartOf="@id/cardIcon"
        android:layout_marginEnd="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="⚠ SPAM"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="@color/surface"
            android:background="#D97706"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/chipScam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="@id/cardIcon"
        app:layout_constraintStart_toEndOf="@id/cardIcon"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="✖ SCAM"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="@color/surface"
            android:background="#DC2626"/>
    </androidx.cardview.widget.CardView>

    <!-- Headline and Subtitle -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_title"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="34sp"
        android:textColor="@color/text_primary"
        android:lineHeight="40sp"
        app:layout_constraintTop_toBottomOf="@id/vHalo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_subtitle"
        android:textAlignment="center"
        android:textSize="15sp"
        android:textColor="#1F2937"
        android:lineSpacingExtra="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"/>

    <!-- Circular Progress Dots (High Visibility Blue) -->

    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <!-- Inactive Dot 1 -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="6dp"
            android:background="@drawable/dot_inactive"
            android:backgroundTint="#BFDBFE" />

        <!-- Active Dot (Highlighted Middle) -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="6dp"
            android:background="@drawable/dot_active"
            android:backgroundTint="#2F6FED" />

        <!-- Inactive Dot 2 -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="6dp"
            android:background="@drawable/dot_inactive"
            android:backgroundTint="#BFDBFE" />
    </LinearLayout>

    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="96dp"
        android:backgroundTint="#2F6FED"
        android:elevation="8dp"
        android:text="@string/btn_get_started_onboarding"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
