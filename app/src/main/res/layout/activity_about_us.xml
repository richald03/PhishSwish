<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_result_header"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_about_us"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvTeamHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/about_meet_team"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- John -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="18dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivMemberJohn"
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    android:src="@drawable/person1"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearanceOverlay="@style/CircleImage" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal"
                                    android:gravity="center">

                                    <ImageView
                                        android:id="@+id/ivFBJohn"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_facebook"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>

                                    <ImageView
                                        android:id="@+id/ivIGJohn"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginStart="8dp"
                                        android:src="@drawable/ic_instagram"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="John Aldrich Payawal"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_role_android"
                                    android:textColor="@color/home_primary"
                                    android:textSize="14sp"
                                    android:drawableStart="@drawable/ic_profile"
                                    android:drawablePadding="6dp"
                                    android:drawableTint="@color/home_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_edu_tip"
                                    android:textColor="@color/text_muted"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:lineSpacingMultiplier="1.25"
                                    android:justificationMode="inter_word"
                                    android:text="@string/about_bio_john"
                                    android:textColor="@color/text_muted"
                                    android:textSize="13sp" />

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Ven -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="18dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivMemberRome"
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    android:src="@drawable/person2"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearanceOverlay="@style/CircleImage" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal"
                                    android:gravity="center">

                                    <ImageView
                                        android:id="@+id/ivFBRome"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_facebook"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>

                                    <ImageView
                                        android:id="@+id/ivIGRome"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginStart="8dp"
                                        android:src="@drawable/ic_instagram"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rome Antig"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_role_ui"
                                    android:textColor="@color/home_primary"
                                    android:textSize="14sp"
                                    android:drawableStart="@drawable/ic_profile"
                                    android:drawablePadding="6dp"
                                    android:drawableTint="@color/home_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_edu_regular"
                                    android:textColor="@color/text_muted"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:lineSpacingMultiplier="1.25"
                                    android:justificationMode="inter_word"
                                    android:text="@string/about_bio_rome"
                                    android:textColor="@color/text_muted"
                                    android:textSize="13sp" />

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Prince -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="18dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivMemberVen"
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/person3"
                                    app:shapeAppearanceOverlay="@style/CircleImage" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal"
                                    android:gravity="center">

                                    <ImageView
                                        android:id="@+id/ivFBVen"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_facebook"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>

                                    <ImageView
                                        android:id="@+id/ivIGVen"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginStart="8dp"
                                        android:src="@drawable/ic_instagram"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ven Andrew Mirasol"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_role_backend"
                                    android:textColor="@color/home_primary"
                                    android:textSize="14sp"
                                    android:drawableStart="@drawable/ic_profile"
                                    android:drawablePadding="6dp"
                                    android:drawableTint="@color/home_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_edu_regular"
                                    android:textColor="@color/text_muted"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:lineSpacingMultiplier="1.25"
                                    android:justificationMode="inter_word"
                                    android:text="@string/about_bio_ven"
                                    android:textColor="@color/text_muted"
                                    android:textSize="13sp" />

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Rome -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        app:cardCornerRadius="18dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivMemberPrince"
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    android:src="@drawable/person4"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearanceOverlay="@style/CircleImage" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal"
                                    android:gravity="center">

                                    <ImageView
                                        android:id="@+id/ivFBPrince"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_facebook"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>

                                    <ImageView
                                        android:id="@+id/ivIGPrince"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginStart="8dp"
                                        android:src="@drawable/ic_instagram"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Prince Blendoel Vetonio"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_role_qa"
                                    android:textColor="@color/home_primary"
                                    android:textSize="14sp"
                                    android:drawableStart="@drawable/ic_profile"
                                    android:drawablePadding="6dp"
                                    android:drawableTint="@color/home_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/about_edu_regular"
                                    android:textColor="@color/text_muted"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:lineSpacingMultiplier="1.25"
                                    android:justificationMode="inter_word"
                                    android:text="@string/about_bio_prince"
                                    android:textColor="@color/text_muted"
                                    android:textSize="13sp" />

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

